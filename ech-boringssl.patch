#
# ech-boringssl.patch — Server-side ECH (Encrypted Client Hello) support
# for BoringSSL builds in Nginx (src/event/ngx_event_openssl.c).
#
# This patch MODIFIES nginx. The file it applies to is
#     Copyright (C) Nginx, Inc. and F5, Inc.
#     Licensed under the 2-clause BSD License.
# The copyright above covers only the changes introduced by this patch, not
# the nginx source it is applied to.
#
# Why it exists: nginx's own ECH support targets the OpenSSL 3.x OSSL_ECHSTORE
# API, which is a no-op against BoringSSL. This adds a BoringSSL branch built
# on SSL_ECH_KEYS_* / EVP_HPKE_KEY_*.
#
# Applied by nginx-update.sh with `patch -p1` against a freshly unpacked nginx
# release tarball; everything above the first `---` is ignored by patch(1).
--- a/src/event/ngx_event_openssl.c
+++ b/src/event/ngx_event_openssl.c
@@ -13,6 +13,12 @@
 #include <zlib.h>
 #endif
 
+#if defined(OPENSSL_IS_BORINGSSL)
+/* BoringSSL keeps the HPKE recipient-key API (needed for server-side ECH)
+ * in a separate header that <openssl/ssl.h> does not pull in. */
+#include <openssl/hpke.h>
+#endif
+
 
 #define NGX_SSL_PASSWORD_BUFFER_SIZE  4096
 
@@ -1747,6 +1753,153 @@
     OSSL_ECHSTORE_free(es);
     return rc;
 
+#elif defined(OPENSSL_IS_BORINGSSL)
+
+    /*
+     * BoringSSL server-side ECH. Each bundled .pem holds one PRIVATE KEY
+     * block and one ECHCONFIG block; load them into an SSL_ECH_KEYS set.
+     * The first file supplies the retry-config advertised on mismatch.
+     */
+
+    BIO                  *in;
+    char                 *pem_name, *pem_header;
+    u_char               *pem_data, *config;
+    long                  pem_len;
+    const u_char         *p;
+    uint8_t               priv[32];
+    size_t                klen, config_len;
+    ngx_int_t             rc, have_key, have_config;
+    ngx_str_t            *filename;
+    ngx_uint_t            i;
+    EVP_PKEY             *pkey;
+    EVP_HPKE_KEY          hpke;
+    SSL_ECH_KEYS         *keys;
+    PKCS8_PRIV_KEY_INFO  *p8;
+
+    if (filenames == NULL) {
+        return NGX_OK;
+    }
+
+    keys = SSL_ECH_KEYS_new();
+    if (keys == NULL) {
+        ngx_ssl_error(NGX_LOG_EMERG, ssl->log, 0, "SSL_ECH_KEYS_new() failed");
+        return NGX_ERROR;
+    }
+
+    rc = NGX_ERROR;
+    filename = filenames->elts;
+
+    for (i = 0; i < filenames->nelts; i++) {
+
+        if (ngx_conf_full_name(cf->cycle, &filename[i], 1) != NGX_OK) {
+            goto failed;
+        }
+
+        in = BIO_new_file((char *) filename[i].data, "r");
+        if (in == NULL) {
+            ngx_ssl_error(NGX_LOG_EMERG, ssl->log, 0,
+                          "BIO_new_file(\"%s\") failed", filename[i].data);
+            goto failed;
+        }
+
+        EVP_HPKE_KEY_zero(&hpke);
+        have_key = 0;
+        have_config = 0;
+        config = NULL;
+        config_len = 0;
+
+        while (PEM_read_bio(in, &pem_name, &pem_header, &pem_data, &pem_len)
+               == 1)
+        {
+            if (ngx_strcmp(pem_name, "PRIVATE KEY") == 0) {
+
+                p = pem_data;
+                p8 = d2i_PKCS8_PRIV_KEY_INFO(NULL, &p, pem_len);
+                pkey = (p8 != NULL) ? EVP_PKCS82PKEY(p8) : NULL;
+                PKCS8_PRIV_KEY_INFO_free(p8);
+
+                klen = sizeof(priv);
+
+                if (pkey == NULL
+                    || EVP_PKEY_get_raw_private_key(pkey, priv, &klen) != 1
+                    || EVP_HPKE_KEY_init(&hpke, EVP_hpke_x25519_hkdf_sha256(),
+                                         priv, klen) != 1)
+                {
+                    EVP_PKEY_free(pkey);
+                    OPENSSL_free(pem_name);
+                    OPENSSL_free(pem_header);
+                    OPENSSL_free(pem_data);
+                    BIO_free(in);
+                    EVP_HPKE_KEY_cleanup(&hpke);
+                    ngx_ssl_error(NGX_LOG_EMERG, ssl->log, 0,
+                                  "loading ECH private key \"%s\" failed",
+                                  filename[i].data);
+                    goto failed;
+                }
+
+                EVP_PKEY_free(pkey);
+                have_key = 1;
+
+            } else if (ngx_strcmp(pem_name, "ECHCONFIG") == 0 && pem_len > 2) {
+
+                /*
+                 * the block carries an ECHConfigList; SSL_ECH_KEYS_add() wants
+                 * a single ECHConfig, so drop the 2-byte list-length prefix.
+                 */
+
+                config = ngx_pnalloc(cf->pool, pem_len - 2);
+                if (config != NULL) {
+                    ngx_memcpy(config, pem_data + 2, pem_len - 2);
+                    config_len = pem_len - 2;
+                    have_config = 1;
+                }
+            }
+
+            OPENSSL_free(pem_name);
+            OPENSSL_free(pem_header);
+            OPENSSL_free(pem_data);
+        }
+
+        BIO_free(in);
+
+        /* the loop ends when PEM_read_bio() hits EOF, which leaves a
+         * benign PEM NO_START_LINE on the error queue; drop it so it is
+         * not later reported as a stale global SSL error at handshake time */
+        ERR_clear_error();
+
+        if (!have_key || !have_config) {
+            ngx_ssl_error(NGX_LOG_EMERG, ssl->log, 0,
+                          "ECH file \"%s\" needs a PRIVATE KEY and an "
+                          "ECHCONFIG block", filename[i].data);
+            EVP_HPKE_KEY_cleanup(&hpke);
+            goto failed;
+        }
+
+        if (SSL_ECH_KEYS_add(keys, i == 0 ? 1 : 0, config, config_len, &hpke)
+            != 1)
+        {
+            ngx_ssl_error(NGX_LOG_EMERG, ssl->log, 0,
+                          "SSL_ECH_KEYS_add(\"%s\") failed", filename[i].data);
+            EVP_HPKE_KEY_cleanup(&hpke);
+            goto failed;
+        }
+
+        EVP_HPKE_KEY_cleanup(&hpke);
+    }
+
+    if (SSL_CTX_set1_ech_keys(ssl->ctx, keys) != 1) {
+        ngx_ssl_error(NGX_LOG_EMERG, ssl->log, 0,
+                      "SSL_CTX_set1_ech_keys() failed");
+        goto failed;
+    }
+
+    rc = NGX_OK;
+
+failed:
+
+    SSL_ECH_KEYS_free(keys);
+    return rc;
+
 #else
     if (filenames != NULL) {
         ngx_log_error(NGX_LOG_WARN, ssl->log, 0,
@@ -5928,6 +6081,12 @@
 
     OPENSSL_free(inner_sni);
     OPENSSL_free(outer_sni);
+#elif defined(OPENSSL_IS_BORINGSSL)
+    if (SSL_ech_accepted(c->ssl->connection)) {
+        ngx_str_set(s, "SUCCESS");
+    } else {
+        ngx_str_set(s, "NOT_TRIED");
+    }
 #else
     s->len = 0;
 #endif
@@ -5965,6 +6124,7 @@
     OPENSSL_free(inner_sni);
     OPENSSL_free(outer_sni);
 #else
+    /* BoringSSL does not expose the outer (public) SNI to the server side */
     s->len = 0;
 #endif
     return NGX_OK;
